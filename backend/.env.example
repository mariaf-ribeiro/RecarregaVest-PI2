# Copie este arquivo para ".env" (na mesma pasta) e ajuste os valores.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Use o usuário root do seu MySQL (o script de carga precisa criar o banco).
MYSQL_USER=root
MYSQL_PASSWORD=coloque_a_senha_do_root_aqui
MYSQL_DATABASE=recarregavest_db

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=recarregavest_nosql

# --- Servidor ---
PORT=3000
# Qualquer texto longo e aleatório (usado para assinar o login).
SESSION_SECRET=troque-por-um-texto-grande-e-aleatorio
